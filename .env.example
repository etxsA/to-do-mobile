# Copy this file to `.env` and fill in the values.
# EXPO_PUBLIC_* vars are inlined into the client bundle by Expo (public, not secret).

# Backend (Quarkus REST API) base URL — no trailing slash, no /api prefix.
EXPO_PUBLIC_API_BASE_URL=https://your-backend-url.example.com

# Firebase Web config (Project settings -> Your apps -> Web app).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
